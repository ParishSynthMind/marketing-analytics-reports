# Copy to .env and fill in. Never commit .env.

# Google (GA4 + Search Console): a service-account JSON key file (preferred for a scheduled job)...
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# ...or a short-lived OAuth access token for a one-off run
# GOOGLE_OAUTH_ACCESS_TOKEN=

GA4_PROPERTY_ID=123456789
GSC_SITE_URL=sc-domain:example.com
# GSC_DATA_STATE=final            # or "all" to include fresh (not yet final) data

# Meta Ads: a token with ads_read (put it in your keychain, see examples/run.sh)
META_AD_ACCOUNT_ID=1234567890
META_CONVERSION_ACTIONS=purchase  # e.g. purchase,lead  (one family per kind, never purchase + omni_purchase)
# META_API_VERSION=v26.0

# Optional
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/marketing
# REPORT_SITE_NAME=Example Ltd
# SMTP_HOST= SMTP_PORT=587 SMTP_USER= SMTP_PASSWORD= REPORT_EMAIL_TO= REPORT_EMAIL_FROM=
# ALERT_WEBHOOK_URL=
# STALE_AFTER_HOURS=26
